{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyReader",
  "version": "0.1.0",
  "identifier": "com.myreader.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyReader",
        "width": 1000,
        "height": 760,
        "minWidth": 520,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
